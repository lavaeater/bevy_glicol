{
  "keybindings": {
    "Home": {
      "<q>": "Quit", // Quit the application
      "<Ctrl-d>": "Quit", // Another way to quit
      "<Ctrl-c>": "Quit", // Yet another way to quit
      "<Ctrl-z>": "Suspend", // Suspend the application
      "<p>": "PlayAudio", // Start playing audio
      "<t>": "SpecialAudio", // SPECIAL
      "<s>": "StopAudio", // Stop playing audio
      "<u>": { "UpdateAudioCode": "out: saw 440.0 >> mul 0.1" }, // Update audio code (example)
      "<g>": { "SwitchMode": "Graph" } // Switch to graph mode
    },
    "Graph": {
      "<q>": "Quit",
      "<Esc>": { "SwitchMode": "Home" }, // Return to home mode
      "<j>": "GraphNextNode", // Select next node
      "<k>": "GraphPrevNode", // Select previous node
      "<l>": "GraphNextCategory", // Next category
      "<h>": "GraphPrevCategory", // Previous category
      "<d>": "GraphRemoveNode", // Delete selected node
      "<Enter>": "GraphStartEditing", // Start editing mode
      "<n>": { "GraphAddNode": "sin" }, // Add sine oscillator (example)
      "<Space>": "GraphClearError" // Clear any error messages
    },
    "GraphEditing": {
      "<Esc>": "GraphStopEditing", // Cancel editing
      "<j>": "GraphNextNode", // Select next node
      "<k>": "GraphPrevNode", // Select previous node
      "<Tab>": "GraphNextParam", // Select next parameter
      "<Shift-Tab>": "GraphPrevParam", // Select previous parameter
      "<Enter>": { "GraphEditParam": ["node_id", 0, "440.0"] } // Example parameter edit
    }
  }
}
